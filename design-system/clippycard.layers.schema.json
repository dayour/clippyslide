{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayour.github.io/clippyslide/schemas/clippycard.layers.schema.json",
  "title": "ClippyCard Layers",
  "description": "Composable layer contract for a ClippySide card. Nitrous is structure (rims, focus, the one selected layer). Spectrum hues are meaning. One active header layer. Credentialed remote-model calls are catalogued, never embedded.",
  "type": "object",
  "required": ["schemaVersion", "card", "header", "sidepane", "pages", "layers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "card": { "$ref": "#/$defs/card" },
    "activeLayer": { "type": "string", "minLength": 1 },
    "header": { "$ref": "#/$defs/header" },
    "sidepane": { "$ref": "#/$defs/sidepane" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "signal": {
      "enum": ["nitrous", "cyan", "purple", "magenta", "green", "orange", "dim"],
      "description": "nitrous = structure only. cyan = active identity or action. purple = primary. magenta = danger or recording. green = live or success. orange = warning. dim = inactive."
    },
    "region": {
      "enum": ["header", "sidepane", "main", "toc", "overlay", "floating", "progress"]
    },
    "card": {
      "type": "object",
      "required": ["id", "title", "theme"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "theme": { "const": "clippyflow" },
        "version": { "type": "string" },
        "sourceTemplate": { "type": "string" }
      }
    },
    "header": {
      "type": "object",
      "required": ["tabs", "toggles"],
      "additionalProperties": false,
      "properties": {
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tab" }
        },
        "toggles": {
          "type": "array",
          "items": { "$ref": "#/$defs/toggle" }
        },
        "add": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string" },
            "href": { "type": "string" },
            "title": { "type": "string" }
          }
        }
      }
    },
    "tab": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "href": { "type": "string" },
        "target": { "enum": ["_self", "_top", "_blank"] },
        "page": { "type": "string" },
        "signal": { "$ref": "#/$defs/signal" },
        "active": { "type": "boolean" }
      }
    },
    "toggle": {
      "type": "object",
      "required": ["id", "title", "control"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "glyph": { "type": "string" },
        "control": {
          "enum": ["sidebar", "record", "search", "theme", "print", "slides", "chat", "edit", "download"]
        },
        "signal": { "$ref": "#/$defs/signal" },
        "functions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sidepane": {
      "type": "object",
      "required": ["sections"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 180, "maximum": 420 },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "collapsible": { "type": "boolean" },
        "collapsed": { "type": "boolean" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/navItem" }
        }
      }
    },
    "navItem": {
      "type": "object",
      "required": ["id", "title", "page"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "page": { "type": "string" },
        "signal": { "$ref": "#/$defs/signal" }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "title", "blocks"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "kicker": { "type": "string" },
        "crumb": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["kicker", "heading", "prose", "chips", "table", "code", "schema"] },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "text": { "type": "string" },
        "items": { "type": "array", "items": { "type": "string" } },
        "headers": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        },
        "lang": { "type": "string" }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "title", "region", "features"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string" },
        "region": { "$ref": "#/$defs/region" },
        "signal": { "$ref": "#/$defs/signal" },
        "summary": { "type": "string" },
        "sourceIds": { "type": "array", "items": { "type": "string" } },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/feature" }
        }
      }
    },
    "feature": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "signal": { "$ref": "#/$defs/signal" },
        "functions": { "type": "array", "items": { "type": "string" } },
        "methods": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "string" }
      }
    }
  }
}
