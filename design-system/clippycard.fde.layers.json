  "pages": [
    {
      "id": "home",
      "title": "ClippySide",
      "kicker": "CLIPPYCARD",
      "crumb": ["ClippySide", "Home"],
      "blocks": [
        { "kind": "kicker", "text": "LAYER SCHEMA" },
        { "kind": "heading", "level": 1, "text": "A sidepane card, in ClippyFlow." },
        { "kind": "prose", "text": "Same shell as the FDE template: sticky header, collapsible sidepane, main document, on-this-page rail, search, assistant, edit lock, and download. Restyled on the ClippyFlow token system. Nitrous rims structure. Spectrum hues mark meaning." },
        { "kind": "chips", "items": ["header", "sidepane", "toggles", "implementation", "assistant", "schema"] },
        { "kind": "heading", "level": 2, "text": "How to edit" },
        { "kind": "prose", "text": "Unlock edits from the header. Titles, sidepane labels, and prose become editable. The schema page accepts a full layer document and re-renders the shell. Download writes the edited card as HTML. Nothing here calls a remote model or stores a credential." }
      ]
    },
    {
      "id": "header",
      "title": "Header",
      "kicker": "REGION",
      "crumb": ["ClippySide", "Header"],
      "blocks": [
        { "kind": "kicker", "text": "CF-WIN-BAR" },
        { "kind": "heading", "level": 1, "text": "Header layers" },
        { "kind": "prose", "text": "Traffic lights, then the composable layer strip, then the command title, then toggles and the live badge. Exactly one .active tab. Close is a sibling button and does not follow the link. Flow stays on this card. Brand Deck opens the deck shell at the top window." },
        { "kind": "table", "headers": ["Slot", "Source", "Signal"], "rows": [["dots", "cf-win-dots", "spectrum"], ["tabs", "cf-layers", "nitrous rim, cyan dot"], ["title", "nav-title", "fg"], ["toggles", "nav-actions", "per control"], ["progress", "scroll-progress", "nitrous"]] }
      ]
    },
    {
      "id": "sidepane",
      "title": "Sidepane",
      "kicker": "REGION",
      "crumb": ["ClippySide", "Sidepane"],
      "blocks": [
        { "kind": "kicker", "text": "ASIDE" },
        { "kind": "heading", "level": 1, "text": "Sidepane" },
        { "kind": "prose", "text": "Fixed under the header. Sections collapse. Items navigate pages and rewrite the breadcrumb. The in-pane outline tracks headings in the main document. Collapsing the pane expands main, matching toggleSidebar." },
        { "kind": "table", "headers": ["Feature", "Functions"], "rows": [["Section fold", "toggleSidebarSection"], ["Navigate", "navigateToPage, showLandingPage, showMarkdownPage, getPageName, updateBreadcrumb"], ["Outline", "generateTOC, generateTOCSidebar, observeTOCSidebarScroll"]] }
      ]
    },
    {
      "id": "toggles",
      "title": "Toggles",
      "kicker": "HEADER",
      "crumb": ["ClippySide", "Toggles"],
      "blocks": [
        { "kind": "kicker", "text": "NAV-ACTIONS" },
        { "kind": "heading", "level": 1, "text": "Header toggles" },
        { "kind": "prose", "text": "Each FDE header button is a toggle in the schema. Theme does not flip to a light Microsoft canvas. ClippyFlow stays dark. The theme control toggles spectrum bloom, which is what loadTheme and toggleTheme mean on this card." },
        { "kind": "table", "headers": ["Control", "Source functions"], "rows": [["sidebar", "toggleSidebar"], ["record", "toggleYumlog, startYumlog, stopYumlog, logYumlogEvent, generateYumlogContent, saveYumlogRecording, saveYumlogFile"], ["search", "openSearch, closeSearch, performSearch, searchAllDocuments"], ["theme", "toggleTheme, loadTheme"], ["slides", "toggleSlideView, renderSlideView, renderNormalView, scrollToSlide, copySlideText, copySlideAsImage"], ["edit", "toggleEditMode, enableContentEditing, disableContentEditing"], ["download", "downloadEditedTemplate, showDownloadNotification"]] }
      ]
    },
    {
      "id": "implementation",
      "title": "Implementation",
      "kicker": "MAIN",
      "crumb": ["ClippySide", "Implementation"],
      "blocks": [
        { "kind": "kicker", "text": "PAGES" },
        { "kind": "heading", "level": 1, "text": "Implementation surface" },
        { "kind": "prose", "text": "The source main region renders markdown pages, code blocks, a table of contents, and per-agent config, guide, and chat slots. This card keeps that shape and fills it with the layer contract instead of a customer policy corpus." },
        { "kind": "heading", "level": 2, "text": "Page render" },
        { "kind": "prose", "text": "renderMarkdown, renderNormalView, and renderSlideView choose the body. postProcessContent and wrapCodeBlock decorate code. copyCode copies a block. Slide view turns h2 sections into cards." },
        { "kind": "heading", "level": 2, "text": "Agent slots" },
        { "kind": "prose", "text": "Source pages agent1, agent2, and agent3 each expose config, guide, and chat. renderAgentChatPage, initializeAgentChat, sendAgentMessage, sendAgentPrompt, and syncAgentModel own that slot. exportAgentConfig and addAgentAssistantSection attach a builder footer. Those slots are features of the implementation layer, not a second theme." }
      ]
    },
    {
      "id": "assistant",
      "title": "Assistant",
      "kicker": "OVERLAY",
      "crumb": ["ClippySide", "Assistant"],
      "blocks": [
        { "kind": "kicker", "text": "LOCAL" },
        { "kind": "heading", "level": 1, "text": "Assistant, without credentials" },
        { "kind": "prose", "text": "The source has three chat surfaces: the pinned chat panel (AIChat), the floating Caddy window (CaddyAIChat), and per-agent chat. Their remote call methods are catalogued and excluded. This card answers from the layer index only." },
        { "kind": "chips", "items": ["toggleChatPanel", "toggleCaddyChat", "positionCaddyWindow", "local reply"] }
      ]
    },
    {
      "id": "schema",
      "title": "Layer schema",
      "kicker": "EDIT",
      "crumb": ["ClippySide", "Schema"],
      "blocks": [
        { "kind": "kicker", "text": "JSON" },
        { "kind": "heading", "level": 1, "text": "Edit the layer document" },
        { "kind": "prose", "text": "Apply re-renders header tabs, toggles, sidepane, and pages from the document. Invalid JSON is refused. Download saves the rendered card, including your edits." },
        { "kind": "schema" }
      ]
    },
    {
      "id": "functions",
      "title": "Function index",
      "kicker": "INDEX",
      "crumb": ["ClippySide", "Functions"],
      "blocks": [
        { "kind": "kicker", "text": "SOURCE MAP" },
        { "kind": "heading", "level": 1, "text": "Every catalogued function" },
        { "kind": "prose", "text": "Grouped by the layer that owns it. The inner debounce closure executedFunction is not a feature. Credentialed model calls are listed under excluded, not wired." }
      ]
    }
