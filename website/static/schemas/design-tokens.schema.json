{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayour.github.io/clippyslide/schemas/design-tokens.schema.json",
  "title": "ClippyDeck Harvest Design Tokens",
  "type": "object",
  "required": ["schemaVersion", "source", "tokens"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "source": {
      "type": "object",
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"enum": ["pptx", "pdf", "html", "image", "video", "clippydeck", "adaptive-card"]},
        "digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "color": {"$ref": "#/$defs/tokenGroup"},
        "gradient": {"$ref": "#/$defs/tokenGroup"},
        "text": {"$ref": "#/$defs/tokenGroup"},
        "spacing": {"$ref": "#/$defs/tokenGroup"},
        "radius": {"$ref": "#/$defs/tokenGroup"},
        "shadow": {"$ref": "#/$defs/tokenGroup"},
        "motion": {"$ref": "#/$defs/tokenGroup"}
      },
      "additionalProperties": {"$ref": "#/$defs/tokenGroup"}
    }
  },
  "$defs": {
    "tokenGroup": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["confidence"],
        "properties": {
          "value": {},
          "family": {"type": "string"},
          "size": {"type": "number"},
          "weight": {"type": "number"},
          "color": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
